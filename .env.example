# Copie este arquivo para ".env" e ajuste o que quiser. Tudo é opcional.

# ---------------- Servidor (porta diferente do Radar de Notícias, os dois podem rodar juntos)
PRECOS_HOST=127.0.0.1
PRECOS_PORT=8010

# ---------------- Monitoramento automático
# Minutos entre buscas de cada produto salvo
PRECOS_INTERVAL_MIN=30
# Minutos entre atualizações dos cupons
PRECOS_COUPON_INTERVAL_MIN=120
PRECOS_AUTO_UPDATE=true
PRECOS_COLLECT_ON_START=true
# Lojas consultadas em paralelo
PRECOS_WORKERS=8
# Lojas desligadas (ids separados por vírgula): mercadolivre,kabum,pichau,terabyte,magalu,amazon,americanas,carrefour,ibyte,shopee,aliexpress,zoom,pelando,promobit
PRECOS_DISABLED_STORES=

# ---------------- Bug de preço (fração do preço de referência = mediana das ofertas)
# Até 50% da referência (desconto de 50% ou mais) = BUGÃO
PRECOS_BUGAO_RATIO=0.50
PRECOS_BUG_RATIO=0.70
PRECOS_DEAL_RATIO=0.88
PRECOS_SUSPECT_RATIO=0.25
# Abaixo desta fração da referência a oferta só fica se o título casar muito bem (senão é descartada)
PRECOS_FLOOR_RATIO=0.20
# Horas em que uma oferta recém-descoberta aparece como "Nova"
PRECOS_NEW_HOURS=24

# ---------------- Mercado Livre (opcional)
# Token da API oficial (veja o README). Sem ele o radar usa o site, que costuma bloquear com verificação de conta.
ML_ACCESS_TOKEN=

# ---------------- Rede
PRECOS_HTTP_TIMEOUT=25
PRECOS_HOST_MIN_INTERVAL=1.5

# ---------------- Aviso no Telegram (opcional): bug de preço, preço alvo atingido
# Crie um bot com o @BotFather e descubra seu chat id com o @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
